<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="_FeelKcontextOpen"
                   expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
                   targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_stringItem" structureRef="String"/>
  <!-- The description reaches past the sandboxed view into the process definition, processInstance.process.id,
       which only resolves when FEEL is not sandboxed. A placeholder is not compiled while the model is built, so
       the document builds in either mode and the difference shows when the description is read. -->
  <bpmn2:process id="FeelKcontextOpen" drools:packageName="org.jbpm.bpmn2.feel" drools:version="1.0" name="BPMN2-FeelKcontextOpen" isExecutable="true" processType="Public">
    <bpmn2:extensionElements>
      <drools:metaData name="customDescription">
        <drools:metaValue><![CDATA[definition #{processInstance.process.id}]]></drools:metaValue>
      </drools:metaData>
    </bpmn2:extensionElements>
    <bpmn2:property id="who" itemSubjectRef="_stringItem" name="who"/>
    <bpmn2:startEvent id="start">
      <bpmn2:outgoing>start-end</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="start-end" sourceRef="start" targetRef="end"/>
    <bpmn2:endEvent id="end"><bpmn2:incoming>start-end</bpmn2:incoming></bpmn2:endEvent>
  </bpmn2:process>
</bpmn2:definitions>
