<definitions id="Definition" targetNamespace="" typeLanguage="http://www.java.com/javaTypes"
             expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
             xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:tns="http://www.jboss.org/drools">

  <itemDefinition id="_sItem" structureRef="String" />

  <process processType="Private" isExecutable="true" id="FeelCallActivity" name="parent" tns:packageName="org.jbpm.bpmn2.feel">
    <property id="childId" itemSubjectRef="_sItem"/>

    <startEvent id="start" />
    <sequenceFlow id="start-call" sourceRef="start" targetRef="call" />
    <!-- the called element is interpolated: "upper case(...)" is FEEL, so this only resolves under the document
         default. It goes through the node interpolation path rather than the assignment one. -->
    <callActivity id="call" name="Call" calledElement="#{upper case(childId)}">
      <ioSpecification>
        <inputSet />
        <outputSet />
      </ioSpecification>
    </callActivity>
    <sequenceFlow id="call-end" sourceRef="call" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
