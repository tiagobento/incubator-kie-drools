<definitions id="Definition" targetNamespace="" typeLanguage="http://www.java.com/javaTypes"
             expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
             xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:tns="http://www.jboss.org/drools">

  <itemDefinition id="_secondsItem" structureRef="Integer" />

  <process processType="Private" isExecutable="true" id="FeelTimer" name="timer" tns:packageName="org.jbpm.bpmn2.feel">
    <property id="seconds" itemSubjectRef="_secondsItem"/>

    <startEvent id="start" />
    <sequenceFlow id="start-timer" sourceRef="start" targetRef="timer" />
    <intermediateCatchEvent id="timer" name="Timer">
      <timerEventDefinition>
        <!-- resolved through the node interpolation path; "string(...)" is FEEL only -->
        <timeDuration xsi:type="tFormalExpression"><![CDATA[#{"PT" + string(seconds) + "S"}]]></timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <sequenceFlow id="timer-end" sourceRef="timer" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
