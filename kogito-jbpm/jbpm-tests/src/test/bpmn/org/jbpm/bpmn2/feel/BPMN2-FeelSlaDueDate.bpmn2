<definitions id="Definition" targetNamespace="" typeLanguage="http://www.java.com/javaTypes"
             expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
             xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:tns="http://www.jboss.org/drools">

  <itemDefinition id="_secondsItem" structureRef="Integer" />

  <process processType="Private" isExecutable="true" id="FeelSlaDueDate" name="sla" tns:packageName="org.jbpm.bpmn2.feel">
    <extensionElements>
      <!-- "string(...)" is a FEEL built-in: under MVEL this would not resolve, the placeholder would survive
           untouched and parsing the duration would fail. -->
      <tns:metaData name="customSLADueDate">
        <tns:metaValue><![CDATA[#{"PT" + string(seconds) + "S"}]]></tns:metaValue>
      </tns:metaData>
    </extensionElements>

    <property id="seconds" itemSubjectRef="_secondsItem"/>

    <startEvent id="start" />
    <sequenceFlow id="start-task" sourceRef="start" targetRef="task" />
    <userTask id="task" name="Task" tns:taskName="Human Task">
      <ioSpecification><inputSet /><outputSet /></ioSpecification>
    </userTask>
    <sequenceFlow id="task-end" sourceRef="task" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
