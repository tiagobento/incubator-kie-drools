<definitions id="Definition" targetNamespace="" typeLanguage="http://www.java.com/javaTypes"
             xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:tns="http://www.jboss.org/drools">
  <process processType="Private" isExecutable="true" id="FEELCHILD" name="child" tns:packageName="org.jbpm.bpmn2.feel">
    <startEvent id="start" />
    <sequenceFlow id="start-end" sourceRef="start" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
