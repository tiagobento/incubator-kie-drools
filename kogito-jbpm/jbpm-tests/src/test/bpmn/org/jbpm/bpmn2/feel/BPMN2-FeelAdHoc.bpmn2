<definitions id="Definition" targetNamespace="" typeLanguage="http://www.java.com/javaTypes"
             expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
             xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:tns="http://www.jboss.org/drools">

  <itemDefinition id="_sItem" structureRef="String" />

  <process processType="Private" isExecutable="true" id="FeelAdHoc" name="adhoc" tns:packageName="org.jbpm.bpmn2.feel">
    <property id="done" itemSubjectRef="_sItem"/>

    <startEvent id="start" />
    <sequenceFlow id="start-adhoc" sourceRef="start" targetRef="adhoc" />

    <adHocSubProcess id="adhoc" name="AdHoc" ordering="Sequential">
      <!-- no language of its own: follows the document default, FEEL.
           "not(...)" plus a null check is FEEL; Java could not compile this. -->
      <completionCondition xsi:type="tFormalExpression"><![CDATA[done != null]]></completionCondition>
      <scriptTask id="inner" name="Inner" scriptFormat="application/feel">
        <script><![CDATA[{ done: "yes" }]]></script>
      </scriptTask>
    </adHocSubProcess>

    <sequenceFlow id="adhoc-end" sourceRef="adhoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
