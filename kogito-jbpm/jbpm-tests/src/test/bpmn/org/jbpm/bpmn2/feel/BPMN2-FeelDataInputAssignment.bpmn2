<definitions id="Definition"
             targetNamespace=""
             typeLanguage="http://www.java.com/javaTypes"
             expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
             xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             xmlns:tns="http://www.jboss.org/drools">

  <itemDefinition id="_firstItem" structureRef="String" />
  <itemDefinition id="_secondItem" structureRef="String" />

  <process processType="Private" isExecutable="true" id="FeelDataInputAssignment" name="process" tns:packageName="org.jbpm.bpmn2.feel">

    <property id="first" itemSubjectRef="_firstItem"/>
    <property id="second" itemSubjectRef="_secondItem"/>

    <startEvent id="_1" name="" />
    <userTask id="_2" name="Task">
      <ioSpecification>
        <dataInput id='greeting' name='greeting'/>
        <dataInput id='shouted' name='shouted'/>
        <inputSet>
          <dataInputRefs>greeting</dataInputRefs>
          <dataInputRefs>shouted</dataInputRefs>
        </inputSet>
        <outputSet>
        </outputSet>
      </ioSpecification>
      <!-- no expressionLanguage of its own: the placeholder follows the document default, FEEL -->
      <dataInputAssociation>
        <sourceRef>first</sourceRef>
        <targetRef>greeting</targetRef>
        <assignment>
          <from>#{upper case(first)} #{second}</from>
          <to>greeting</to>
        </assignment>
      </dataInputAssociation>
      <!-- a lone #{expression}: it must be evaluated, not stripped of its #{} and read as a constant -->
      <dataInputAssociation>
        <sourceRef>first</sourceRef>
        <targetRef>shouted</targetRef>
        <assignment>
          <from>#{upper case(first)}</from>
          <to>shouted</to>
        </assignment>
      </dataInputAssociation>
    </userTask>
    <endEvent id="_3" name="" />

    <sequenceFlow id="_1-_2" sourceRef="_1" targetRef="_2" />
    <sequenceFlow id="_2-_3" sourceRef="_2" targetRef="_3" />

  </process>

</definitions>
