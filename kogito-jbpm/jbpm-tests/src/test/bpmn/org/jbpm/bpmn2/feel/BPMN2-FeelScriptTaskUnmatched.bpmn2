<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="_FeelScriptTaskUnmatched"
                   expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
                   targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_knownItem" structureRef="Object"/>
  <bpmn2:process id="FeelScriptTaskUnmatched" drools:packageName="org.jbpm.bpmn2.feel" drools:version="1.0" name="BPMN2-FeelScriptTaskUnmatched" isExecutable="true" processType="Public">
    <bpmn2:property id="known" itemSubjectRef="_knownItem" name="known"/>

    <bpmn2:startEvent id="start">
      <bpmn2:outgoing>start-script</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="start-script" sourceRef="start" targetRef="script"/>

    <bpmn2:scriptTask id="script" name="Script" scriptFormat="application/feel">
      <bpmn2:incoming>start-script</bpmn2:incoming>
      <bpmn2:outgoing>script-end</bpmn2:outgoing>
      <bpmn2:script><![CDATA[{ known: 1, notAVariable: 2 }]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:sequenceFlow id="script-end" sourceRef="script" targetRef="end"/>

    <bpmn2:endEvent id="end">
      <bpmn2:incoming>script-end</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
</bpmn2:definitions>
