<definitions id="Definition" targetNamespace="" typeLanguage="http://www.java.com/javaTypes"
             expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
             xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:tns="http://www.jboss.org/drools">

  <itemDefinition id="_scoreItem" structureRef="Integer" />
  <itemDefinition id="_pathItem" structureRef="String" />

  <process processType="Private" isExecutable="true" id="FeelPrecedence" name="process" tns:packageName="org.jbpm.bpmn2.feel">
    <property id="score" itemSubjectRef="_scoreItem"/>
    <property id="path" itemSubjectRef="_pathItem"/>

    <startEvent id="start" />
    <sequenceFlow id="start-split" sourceRef="start" targetRef="split" />
    <exclusiveGateway id="split" gatewayDirection="Diverging" />

    <!-- declares MVEL of its own, inside a FEEL document: the field wins.
         "score.intValue() > 5" is Java-bean syntax MVEL accepts and FEEL cannot parse. -->
    <sequenceFlow id="split-mvel" sourceRef="split" targetRef="mvel">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.mvel.org/2.0">score.intValue() &gt; 5</conditionExpression>
    </sequenceFlow>
    <!-- declares nothing: follows the document default, FEEL -->
    <sequenceFlow id="split-feel" sourceRef="split" targetRef="feel">
      <conditionExpression xsi:type="tFormalExpression">score in [0..5]</conditionExpression>
    </sequenceFlow>

    <scriptTask id="mvel" name="Mvel" scriptFormat="application/feel">
      <script><![CDATA[{ path: "mvel" }]]></script>
    </scriptTask>
    <sequenceFlow id="mvel-end" sourceRef="mvel" targetRef="end1" />
    <endEvent id="end1" />

    <scriptTask id="feel" name="Feel" scriptFormat="application/feel">
      <script><![CDATA[{ path: "feel" }]]></script>
    </scriptTask>
    <sequenceFlow id="feel-end" sourceRef="feel" targetRef="end2" />
    <endEvent id="end2" />
  </process>
</definitions>
