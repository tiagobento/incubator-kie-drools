<definitions id="Definition"
             targetNamespace=""
             typeLanguage="http://www.java.com/javaTypes"
             expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
             xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             xmlns:tns="http://www.jboss.org/drools">

  <itemDefinition id="_nameItem" structureRef="String" />

  <process processType="Private" isExecutable="true" id="FeelTransformation" name="process" tns:packageName="org.jbpm.bpmn2.feel">

    <property id="name" itemSubjectRef="_nameItem"/>

    <startEvent id="_1" name="" />
    <userTask id="_2" name="Task">
      <ioSpecification>
        <dataInput id='shouted' name='shouted'/>
        <inputSet>
          <dataInputRefs>shouted</dataInputRefs>
        </inputSet>
        <outputSet>
        </outputSet>
      </ioSpecification>
      <dataInputAssociation>
        <sourceRef>name</sourceRef>
        <targetRef>shouted</targetRef>
        <!-- no language of its own: the transformation follows the document default, FEEL.
             It returns a string, which a condition evaluator would have rejected. -->
        <transformation>upper case(name) + "!"</transformation>
      </dataInputAssociation>
    </userTask>
    <endEvent id="_3" name="" />

    <sequenceFlow id="_1-_2" sourceRef="_1" targetRef="_2" />
    <sequenceFlow id="_2-_3" sourceRef="_2" targetRef="_3" />

  </process>

</definitions>
