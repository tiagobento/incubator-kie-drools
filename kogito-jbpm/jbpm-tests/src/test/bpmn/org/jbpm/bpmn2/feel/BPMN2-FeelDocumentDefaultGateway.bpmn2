<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="_FeelDocumentDefaultGateway"
                   expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
                   targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_scoreItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_gradeItem" structureRef="String"/>
  <bpmn2:process id="FeelDocumentDefaultGateway" drools:packageName="org.jbpm.bpmn2.feel" drools:version="1.0" name="BPMN2-FeelDocumentDefaultGateway" isExecutable="true" processType="Public">
    <bpmn2:property id="score" itemSubjectRef="_scoreItem" name="score"/>
    <bpmn2:property id="grade" itemSubjectRef="_gradeItem" name="grade"/>

    <bpmn2:startEvent id="start">
      <bpmn2:outgoing>start-split</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="start-split" sourceRef="start" targetRef="split"/>

    <bpmn2:exclusiveGateway id="split" gatewayDirection="Diverging">
      <bpmn2:incoming>start-split</bpmn2:incoming>
      <bpmn2:outgoing>split-pass</bpmn2:outgoing>
      <bpmn2:outgoing>split-fail</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <!-- neither conditionExpression declares a language: both follow the document expressionLanguage.
         "score >= 50" parses under FEEL and under MVEL alike, so the FEEL-only "between" is what proves
         which engine ran. -->
    <bpmn2:sequenceFlow id="split-pass" sourceRef="split" targetRef="pass">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[score in [50..100]]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="split-fail" sourceRef="split" targetRef="fail">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[score in [0..49]]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>

    <bpmn2:scriptTask id="pass" name="Pass" scriptFormat="application/feel">
      <bpmn2:incoming>split-pass</bpmn2:incoming>
      <bpmn2:outgoing>pass-end</bpmn2:outgoing>
      <bpmn2:script><![CDATA[{ grade: "pass" }]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:sequenceFlow id="pass-end" sourceRef="pass" targetRef="end1"/>
    <bpmn2:endEvent id="end1"><bpmn2:incoming>pass-end</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:scriptTask id="fail" name="Fail" scriptFormat="application/feel">
      <bpmn2:incoming>split-fail</bpmn2:incoming>
      <bpmn2:outgoing>fail-end</bpmn2:outgoing>
      <bpmn2:script><![CDATA[{ grade: "fail" }]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:sequenceFlow id="fail-end" sourceRef="fail" targetRef="end2"/>
    <bpmn2:endEvent id="end2"><bpmn2:incoming>fail-end</bpmn2:incoming></bpmn2:endEvent>
  </bpmn2:process>
</bpmn2:definitions>
