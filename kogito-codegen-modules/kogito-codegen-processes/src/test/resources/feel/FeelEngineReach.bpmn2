<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="_FeelEngineReach"
                   expressionLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/"
                   targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_amountItem" structureRef="Integer"/>
  <bpmn2:process id="FeelEngineReach" drools:packageName="org.kie.kogito.feel" drools:version="1.0" name="FeelEngineReach" isExecutable="true" processType="Public">
    <bpmn2:property id="amount" itemSubjectRef="_amountItem" name="amount"/>
    <bpmn2:startEvent id="start"><bpmn2:outgoing>start-split</bpmn2:outgoing></bpmn2:startEvent>
    <bpmn2:sequenceFlow id="start-split" sourceRef="start" targetRef="split"/>
    <bpmn2:exclusiveGateway id="split" gatewayDirection="Diverging">
      <bpmn2:incoming>start-split</bpmn2:incoming>
      <bpmn2:outgoing>split-yes</bpmn2:outgoing>
      <bpmn2:outgoing>split-no</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <!-- a reach past the sandboxed view of kcontext into the engine: not a key of the view, so it does not compile sandboxed -->
    <bpmn2:sequenceFlow id="split-yes" sourceRef="split" targetRef="end1">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[kcontext.kieRuntime != null and amount >= 10]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="split-no" sourceRef="split" targetRef="end2">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[amount < 10]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:endEvent id="end1"><bpmn2:incoming>split-yes</bpmn2:incoming></bpmn2:endEvent>
    <bpmn2:endEvent id="end2"><bpmn2:incoming>split-no</bpmn2:incoming></bpmn2:endEvent>
  </bpmn2:process>
</bpmn2:definitions>
